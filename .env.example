# Clerk: get the development keys from your own instance. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Filled by selecting the existing cloud DEVELOPMENT deployment:
# pnpm exec convex deployment select daniel-caluff:slotly:dev/slotly
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set CLERK_JWT_ISSUER_DOMAIN on the Convex backend, not in the browser:
# pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN https://YOUR-INSTANCE.clerk.accounts.dev
