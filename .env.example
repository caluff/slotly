# Clerk: get the development keys from your own instance. Never commit real keys.
SLOTLY_APP_ENV=development
SLOTLY_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Filled by selecting the existing cloud DEVELOPMENT deployment:
# pnpm exec convex deployment select daniel-caluff:slotly:dev/slotly
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set CLERK_JWT_ISSUER_DOMAIN on the Convex backend, not in the browser:
# pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN https://YOUR-INSTANCE.clerk.accounts.dev

# Backend Convex only. PENDING: Slotly-owned verified sender and sending credential.
# Leave all blank until configured and a real send has its own authorization.
# Sender format: Slotly <ADDRESS_ON_YOUR_VERIFIED_DOMAIN>
# Never reuse another project's credentials. No browser/public variables.
SLOTLY_EMAIL_FROM=
SLOTLY_EMAIL_RESEND_API_KEY=
# Set true on the backend only after sender/key verification; still requires owner opt-in.
SLOTLY_EMAIL_READY=false
